DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"
JWT_SECRET="<generate-a-random-secret-at-least-32-characters>"
ADMIN_EMAIL="admin@alhidayah.sch.id"
ADMIN_PASSWORD="<set-a-unique-password-at-least-12-characters>"
FRONTEND_ORIGINS="http://localhost:3000"
# Set to "none" for HTTPS frontend/backend on different sites (for example Vercel + Render).
# COOKIE_SAME_SITE=none requires production HTTPS and Secure cookies.
COOKIE_SAME_SITE="lax"
PORT=3001
SCHOOL_NAME=""
SCHOOL_FOUNDATION=""
SCHOOL_NPSN=""
SCHOOL_ADDRESS=""
SCHOOL_PHONE=""
PRINCIPAL_NAME=""
PRINCIPAL_NIP=""
RAPOR_DATE_GANJIL=""
RAPOR_DATE_GENAP=""
