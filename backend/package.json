{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema=prisma/schema.prisma",
    "build": "npm run prisma:generate && tsc --outDir dist --rootDir .",
    "start": "node dist/src/index.js",
    "typecheck": "npm run prisma:generate && tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "backfill:academic-history": "tsx prisma/backfill-academic-history.ts",
    "backfill:academic-history:apply": "tsx prisma/backfill-academic-history.ts --apply",
    "postinstall": "prisma generate || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "prisma": "^5.19.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
