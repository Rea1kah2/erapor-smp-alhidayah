// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GURU_MAPEL
  GURU_WALI
  SISWA
  ORTU
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(SISWA)
  createdAt DateTime @default(now())

  // Relasi ke tabel profil
  guru  Guru?
  siswa Siswa?
  ortu  Ortu?
}

model Guru {
  id     String  @id @default(uuid())
  nip    String  @unique
  nama   String
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id])

  // Wali kelas
  kelasWali      Kelas?
  // Mengajar mapel
  mapel          Mapel[]
  penugasanMapel PenugasanMapel[]
  penugasanWali  PenugasanWali[]
}

model Siswa {
  id      String  @id @default(uuid())
  nisn    String  @unique
  nama    String
  kelasId String?
  kelas   Kelas?  @relation(fields: [kelasId], references: [id])
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id])
  ortuId  String?
  ortu    Ortu?   @relation(fields: [ortuId], references: [id])

  // Relasi nilai
  nilai        Nilai[]
  catatanRapor CatatanRapor[]
  riwayatKelas RiwayatKelas[]
}

model Ortu {
  id     String @id @default(uuid())
  nama   String
  nik    String @unique
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  anak Siswa[]
}

model Kelas {
  id            String       @id @default(uuid())
  nama          String // Misal: "VII-A", "VIII-B", "IX-1"
  tingkat       Int // 7, 8, 9 (Jenjang SMP)
  waliId        String?      @unique
  wali          Guru?        @relation(fields: [waliId], references: [id])
  tahunAjaranId String?
  tahunAjaran   TahunAjaran? @relation(fields: [tahunAjaranId], references: [id], onDelete: Restrict)

  siswa          Siswa[]
  riwayatSiswa   RiwayatKelas[]
  penugasanMapel PenugasanMapel[]
  penugasanWali  PenugasanWali[]
}

model Mapel {
  id     String  @id @default(uuid())
  nama   String // "Matematika", "Bahasa Inggris", "IPA", "IPS", dll
  kkm    Float   @default(75)
  guruId String?
  guru   Guru?   @relation(fields: [guruId], references: [id])

  nilai     Nilai[]
  penugasan PenugasanMapel[]
}

model TahunAjaran {
  id        String   @id @default(uuid())
  nama      String   @unique // Contoh: "2025/2026"
  aktif     Boolean  @default(false)
  createdAt DateTime @default(now())

  riwayatKelas   RiwayatKelas[]
  kelas          Kelas[]
  penugasanMapel PenugasanMapel[]
  penugasanWali  PenugasanWali[]
}

// Snapshot kelas siswa untuk setiap tahun ajaran. Perpindahan kelas
// membuat/memperbarui baris tahun berjalan tanpa menghapus riwayat lama.
model RiwayatKelas {
  id            String      @id @default(uuid())
  siswaId       String
  kelasId       String
  tahunAjaranId String
  siswa         Siswa       @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  kelas         Kelas       @relation(fields: [kelasId], references: [id], onDelete: Restrict)
  tahunAjaran   TahunAjaran @relation(fields: [tahunAjaranId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())

  @@unique([siswaId, tahunAjaranId])
  @@index([kelasId, tahunAjaranId])
}

// Satu guru mengajar satu mapel di banyak kelas; satu kelas/mapel/tahun
// memiliki satu penanggung jawab agar input nilai tidak ambigu.
model PenugasanMapel {
  id            String      @id @default(uuid())
  guruId        String
  mapelId       String
  kelasId       String
  tahunAjaranId String
  guru          Guru        @relation(fields: [guruId], references: [id], onDelete: Restrict)
  mapel         Mapel       @relation(fields: [mapelId], references: [id], onDelete: Restrict)
  kelas         Kelas       @relation(fields: [kelasId], references: [id], onDelete: Restrict)
  tahunAjaran   TahunAjaran @relation(fields: [tahunAjaranId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())

  @@unique([mapelId, kelasId, tahunAjaranId])
  @@index([guruId, tahunAjaranId])
}

model PenugasanWali {
  id            String      @id @default(uuid())
  guruId        String
  kelasId       String
  tahunAjaranId String
  guru          Guru        @relation(fields: [guruId], references: [id], onDelete: Restrict)
  kelas         Kelas       @relation(fields: [kelasId], references: [id], onDelete: Restrict)
  tahunAjaran   TahunAjaran @relation(fields: [tahunAjaranId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())

  @@unique([kelasId, tahunAjaranId])
  @@index([guruId, tahunAjaranId])
}

// backend/prisma/schema.prisma

model Nilai {
  id          String @id @default(cuid())
  skor        Float // Menyimpan angka desimal/bulat (misal: 85.5)
  jenis       String // Kategori: "TUGAS", "UTS", "UAS"
  semester    String // "GANJIL" atau "GENAP"
  tahunAjaran String // Format: "2025/2026"

  // Relasi
  siswaId String
  siswa   Siswa  @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  mapelId String
  mapel   Mapel  @relation(fields: [mapelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siswaId, mapelId, jenis, semester, tahunAjaran])
}

model CatatanRapor {
  id          String @id @default(uuid())
  semester    String // "GANJIL" atau "GENAP"
  tahunAjaran String // Format: "2025/2026"

  // Kehadiran (Presensi)
  sakit Int @default(0)
  izin  Int @default(0)
  alfa  Int @default(0)

  // Nilai Sikap
  sikapSpiritual     String? // "A", "B", "C", "D"
  deskripsiSpiritual String?
  sikapSosial        String? // "A", "B", "C", "D"
  deskripsiSosial    String?

  // Ekstrakurikuler (JSON format: [{ "nama": "Pramuka", "predikat": "A", "keterangan": "Sangat aktif" }])
  ekskul Json? @default("[]")

  // Catatan Perkembangan dari Wali Kelas
  catatanWali    String?
  statusKenaikan String? // Misal: "Naik ke Kelas VIII", "Lulus", dll.

  // Catatan Perkembangan dari Orang Tua (Tiap Akhir Semester)
  catatanOrtu    String?
  catatanOrtuAt  DateTime?

  // Relasi
  siswaId String
  siswa   Siswa  @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siswaId, semester, tahunAjaran])
}
